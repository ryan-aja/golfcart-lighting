[Unit]
Description=Golf Cart Lighting Controller
Documentation=file:///home/pi/golf-cart-lighting/README.md

# Deliberately NOT network-online.target.
#
# The cart is designed to run isolated — a Pi and a BC-204 on a cable, no
# router, no uplink. Waiting for the network to be "online" in that situation
# means waiting for something that will never happen: on a cart with no AP in
# range, NetworkManager-wait-online burns its full 60s timeout and fails, every
# single boot, before the lights are allowed to start. Even on the bench it was
# measured at 1min 9s of a 1min 12s boot.
#
# Nothing here needs it. The HTTP server binds 0.0.0.0, the kiosk talks to
# localhost, and the Art-Net socket tolerates a link that is not up yet — sends
# fail with ENETUNREACH until eth0 appears and then recover on their own, which
# the transport now reports honestly.
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/golf-cart-lighting
ExecStart=/usr/bin/node server/index.js

# Real Art-Net output. Remove this line (or set it to true) to run the Pi in
# simulation mode without disconnecting the BC-204.
Environment=LIGHTING_SIMULATION=false
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info

# Theme audio. This is a system service, so it gets no user-session
# environment — and on Trixie the ALSA default is routed through the PipeWire
# running in the desktop session. Without XDG_RUNTIME_DIR the player cannot
# reach that socket and dies with "Couldn't open audio device: Unknown error
# 524", which looks like a track finishing early rather than a failure.
# The installer rewrites 1000 to the real uid of the user it installs for.
Environment=XDG_RUNTIME_DIR=/run/user/1000

Restart=always
RestartSec=3

# Give the graceful shutdown handler time to blackout the DMX universes
# before systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=golfcart-lighting

[Install]
WantedBy=multi-user.target
