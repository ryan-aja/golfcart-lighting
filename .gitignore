node_modules/
client/dist/
*.log
.DS_Store
.env
.env.local

# Theme audio: generated by scripts/make-theme.js, or a file you supplied
# yourself. Either way it is a binary that does not belong in the repo — and a
# commercial recording could not be redistributed here anyway.
assets/audio/*
!assets/audio/README.md

# Which rig this particular machine is wired for. Deliberately untracked: it is
# a per-machine choice, and tracking it would mean every upgrade either fought
# the local edit or silently repointed the machine at another rig.
config/profile.json
